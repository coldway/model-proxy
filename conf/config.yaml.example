# Model Proxy 运行配置
# 复制此文件为 conf/config.yaml 并填入你的 API Key
# 注意：conf/config.yaml 已被 .gitignore 排除，不会提交到仓库
#
# 此文件仅保存 API Key 和服务设置
# 厂商启用状态、优先级、模型列表等均在 conf/providers_catalog.yaml 中管理

providers:
  google:
    api_key: "YOUR_GOOGLE_API_KEY"
  groq:
    api_key: ""
  cerebras:
    api_key: ""
  sambanova:
    api_key: ""
  github:
    api_key: ""
  openrouter:
    api_key: ""
  mistral:
    api_key: ""
  cloudflare:
    api_key: ""  # 格式: "account_id:api_token"
  huggingface:
    api_key: ""
  cursor:
    api_key: ""  # Cursor 无需 API Key，留空即可

settings:
  host: "127.0.0.1"
  port: 8000
  default_provider: "google"
  auto_switch: true
  log_level: "info"
  admin_token: ""              # 管理面板认证令牌，为空则不启用认证
  route_cache_ttl: 600         # LLM 路由缓存有效期（秒）
  breaker_threshold: 3         # 连续失败 N 次触发厂商熔断
  breaker_cooldown: 300        # 熔断冷却时间（秒）
  max_context_tokens: 8000     # 聊天会话上下文最大 token 数
  max_sessions: 50             # 最大聊天会话数
  probe_interval: 5            # 能力探测间隔（秒）
