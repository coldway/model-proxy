# Model Proxy 配置模板
# 复制此文件为 conf/config.yaml 并填入你的 API Key
# 注意：conf/config.yaml 已被 .gitignore 排除，不会提交到仓库
#
# 获取方式：
#   Google:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   GitHub:     Settings > Developer settings > Personal access tokens
#   Cerebras:   https://cloud.cerebras.ai/
#   SambaNova:  https://cloud.sambanova.ai/
#   OpenRouter: https://openrouter.ai/keys
#   Mistral:    https://console.mistral.ai/api-keys/
#   NVIDIA:     https://build.nvidia.com/
#   Cohere:     https://dashboard.cohere.com/api-keys
#   DashScope:  https://bailian.console.aliyun.com/ → API-KEY 管理
#   Cloudflare: Dashboard > AI > Workers AI
#   HuggingFace: https://huggingface.co/settings/tokens

providers:
  google:
    api_key: ""
  groq:
    api_key: ""
  cerebras:
    api_key: ""
  sambanova:
    api_key: ""
  github:
    api_key: ""
  openrouter:
    api_key: ""
  mistral:
    api_key: ""
  nvidia:
    api_key: ""
  cohere:
    api_key: ""
  dashscope:
    api_key: ""
  cloudflare:
    api_key: ""  # 格式: "account_id:api_token"
  huggingface:
    api_key: ""
  cursor:
    api_key: ""  # Cursor 无需 API Key，留空即可

settings:
  host: "127.0.0.1"
  port: 8000
  default_provider: "google"
  auto_switch: true
  log_level: "info"

  # ─── 认证配置（公网暴露时强烈建议启用） ───

  # 方式一：单 Key 模式（简单场景）
  # api_token: "sk-your-single-api-key"

  # 方式二：多 Key 模式（多用户/多服务，各自独立限流）
  # api_keys:
  #   - key: "sk-novel-engine-abc123"
  #     name: "novel-engine"       # 标识名（日志和统计中显示）
  #     rpm: 120                   # 该 Key 独立的每分钟请求限额
  #   - key: "sk-external-user-xyz789"
  #     name: "external-client"
  #     rpm: 30
  #   - key: "sk-unlimited-admin-key"
  #     name: "admin-level"
  #     rpm: 0                     # 0 = 使用全局 per_consumer_rpm（默认不限）

  # 管理面板认证（Web UI + 内部 API）
  # admin_token: "adm-secret-token"

  # 全局限流（api_keys 中未设置 rpm 的 Key 使用此值）
  # per_consumer_rpm: 60          # 0 = 不限制

  # ─── 生成强令牌 ───
  # openssl rand -hex 32
