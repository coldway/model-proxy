# Model Proxy 配置模板
# 复制此文件为 conf/config.yaml 并填入你的 API Key
# 注意：conf/config.yaml 已被 .gitignore 排除，不会提交到仓库
#
# 获取方式：
#   Google:     https://aistudio.google.com/apikey
#   Groq:       https://console.groq.com/keys
#   GitHub:     Settings > Developer settings > Personal access tokens
#   Cerebras:   https://cloud.cerebras.ai/
#   SambaNova:  https://cloud.sambanova.ai/
#   OpenRouter: https://openrouter.ai/keys
#   Mistral:    https://console.mistral.ai/api-keys/
#   NVIDIA:     https://build.nvidia.com/
#   Cohere:     https://dashboard.cohere.com/api-keys
#   DashScope:  https://bailian.console.aliyun.com/ → API-KEY 管理
#   Cloudflare: Dashboard > AI > Workers AI
#   HuggingFace: https://huggingface.co/settings/tokens

providers:
  google:
    api_key: ""
  groq:
    api_key: ""
  cerebras:
    api_key: ""
  sambanova:
    api_key: ""
  github:
    api_key: ""
  openrouter:
    api_key: ""
  mistral:
    api_key: ""
  nvidia:
    api_key: ""
  cohere:
    api_key: ""
  dashscope:
    api_key: ""
  cloudflare:
    api_key: ""  # 格式: "account_id:api_token"
  huggingface:
    api_key: ""
  cursor:
    api_key: ""  # Cursor 无需 API Key，留空即可

settings:
  host: "127.0.0.1"
  port: 8000
  default_provider: "google"
  auto_switch: true
  log_level: "info"
  # admin_token: ""    # 管理面板认证 token（可选）
  # api_token: ""      # OpenAI API 认证 token（可选）
